APP_NAME=StockWise API
APP_ENV=development
APP_PORT=8000
CLIENT_URL=http://localhost:3000
INTERNAL_API_KEY=your-random-secret-at-least-32-characters-long
# Optional comma-separated Fernet key ring. First key encrypts new TOTP secrets;
# keep previous keys after it so existing secrets remain decryptable.
# Generate a key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEYS=

GOOGLE_CLIENT_ID=your-google-oauth-client-id
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-dedicated-sender@gmail.com
SMTP_APP_PASSWORD=your-gmail-app-password-without-spaces

DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/stockwise
